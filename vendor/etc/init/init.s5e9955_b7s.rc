    chown system input /sys/class/sensor_event/symlink/als_rear/enable
    chown system input /sys/class/sensor_event/symlink/als_rear/poll_delay
    chmod 0600 /dev/als_rear
    chown system system /dev/als_rear

on fs
# Mesh
    chown system system /dev/mesh
    chmod 0660 /dev/mesh
    chown system system /sys/class/sec/sec_kq_mesh/panic
    chmod 0664 /sys/class/sec/sec_kq_mesh/panic
    
# Permissions for backlight
