    chmod 0440 /sys/class/aiqe/aiqe1/xml
    chown system system /sys/class/aiqe/aiqe1/xml
    chmod 0440 /sys/class/aiqe/aiqe1/copr
    chown system system /sys/class/aiqe/aiqe1/copr

# DP DEX control
    chmod 0660 /sys/class/dp_sec/dex
    chown system system /sys/class/dp_sec/dex
# DP error info
    chmod 0660 /sys/class/dp_sec/dp_error_info
    chown system system /sys/class/dp_sec/dp_error_info

service abox_log /vendor/bin/abox_log sec-audio-debug /data/vendor/log/abox
    class late_start
    user audioserver
    group system

# Create carrier folder for HiddenMenu
on post-fs
    mkdir /efs/carrier 0755 radio system
    chown radio system /efs/carrier
    chown radio system /efs/carrier/HiddenMenu

on property:sys.dexopt.ctrl=true
    setprop dalvik.vm.dex2oat-cpu-set "0,1,2"
    setprop dalvik.vm.dex2oat-threads 3

on property:sys.dexopt.ctrl=false
    setprop dalvik.vm.dex2oat-cpu-set ""
    setprop dalvik.vm.dex2oat-threads ""
