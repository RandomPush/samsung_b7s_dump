service hermesd2 /vendor/bin/hermesd2 /data/vendor/gatekeeper
    class hal
    user system
    group system 5678
    socket hermes_secnvm stream 660 system system
    capabilities WAKE_ALARM

on post-fs-data
    mkdir /data/vendor/gatekeeper 0770 system system
    mkdir /mnt/vendor/efs/hermes 0770 system system
    chown system system /dev/hestia
    chmod 0660 /dev/hestia