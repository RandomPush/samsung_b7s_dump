<ExternalCamera>
    <Provider>
        <ignore> <!-- Internal video devices to be ignored by external camera HAL -->
            <id>6</id> <!-- No leading/trailing spaces -->
            <id>7</id>
            <id>8</id>
            <id>9</id>
            <id>10</id>
            <id>11</id>
            <id>12</id>
            <id>13</id>
            <id>50</id>
            <id>100</id>
            <id>101</id>
            <id>102</id>
            <id>103</id>
            <id>104</id>
            <id>105</id>
            <id>110</id>
            <id>111</id>
            <id>112</id>
            <id>113</id>
            <id>120</id>
            <id>121</id>
            <id>122</id>
            <id>123</id>
            <id>130</id>
            <id>131</id>
            <id>132</id>
            <id>133</id>
            <id>140</id>
            <id>141</id>
            <id>142</id>
            <id>143</id>
            <id>150</id>
